// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model League {
    id        Int      @id @default(autoincrement())
    slug      String   @unique
    name      String
    country   String
    createdAt DateTime @default(now())

    stadiums Stadium[]
}

model Stadium {
    id        Int      @id @default(autoincrement())
    name      String
    city      String
    country   String
    latitude  Float
    longitude Float
    leagueId  Int
    league    League   @relation(fields: [leagueId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([leagueId])
}

model Record {
    id             Int      @id @default(autoincrement())
    league         String
    wpm            Float
    accuracy       Float
    timeSeconds    Int
    completedCount Int
    createdAt      DateTime @default(now())

    @@index([league, wpm])
}
